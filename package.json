{
  "name": "cfo-agent",
  "version": "0.1.0",
  "private": true,
  "description": "CFO Agent: per-job escrow with top-ups for a GPU-renting AI agent, gated by code rules and a Qwen3-32B CFO review, audited from records + public RPC.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test \"test/ts/**/*.test.ts\"",
    "test:sol": "forge test",
    "typecheck": "tsc --noEmit",
    "build:sol": "forge build",
    "gen:abi": "forge build && tsx scripts/gen-abi.ts",
    "gen:fixtures": "tsx scripts/gen-fixtures.ts",
    "check-secrets": "bash scripts/check-secrets.sh",
    "hooks": "git config core.hooksPath .githooks",
    "deploy": "tsx scripts/deploy.ts",
    "preflight": "tsx scripts/preflight.ts",
    "sign-spec": "tsx scripts/sign-spec.ts",
    "anvil": "anvil --block-time 2",
    "session": "tsx scripts/run.ts",
    "e2e:local": "tsx scripts/e2e-local.ts",
    "audit": "tsx auditor/cli.ts",
    "report": "tsx scripts/report.ts",
    "smoke:kiln": "tsx scripts/kiln-tools.ts smoke",
    "eval:f2": "tsx scripts/kiln-tools.ts eval",
    "nothink": "tsx scripts/kiln-tools.ts nothink",
    "wind-down": "tsx scripts/wind-down.ts",
    "crash:test": "tsx scripts/crash-test.ts",
    "health": "tsx scripts/health.ts"
  },
  "dependencies": {
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
