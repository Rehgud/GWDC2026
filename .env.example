# Copy to .env and fill in. .env is git-ignored; scripts/check-secrets.sh greps
# the real values of *_PK / *_KEY / *SECRET* / *TOKEN* entries out of history,
# the working tree, runs/ and dist/ before every commit.

# --- chain -------------------------------------------------------------------
# anvil | base-sepolia
CHAIN=anvil
# Two RPCs; the backend falls back from the first to the second.
RPC_URL=http://127.0.0.1:8545
RPC_URL_FALLBACK=

# --- keys (D1) -----------------------------------------------------------------
# Agent hot key: open / topUp / settle / close / recordDecision.
# Use a NEW agent key for every recorded vault (one run = one vault = one bundle).
AGENT_PK=
# Founder key for dashboard actions (STOP, founder settle/close, refund) routed
# through POST /action -> commit(). Deploy and spec signing use the forge
# keystore instead (forge --account founder).
# DEMO LIMITATION: both keys live on one server. If the server is compromised,
# an attacker can call setVendor and drain the whole budget.
FOUNDER_PK=

# --- LLM (Kiln, qwen3-32b) -------------------------------------------------------
# Required, no default, no automatic fallback: kiln | stub
# `audit --submission` FAILs a bundle that contains a single stub call.
LLM_MODE=
KILN_URL=
KILN_API_KEY=
KILN_MODEL=qwen3-32b
F1_TIMEOUT_MS=10000
F2_TIMEOUT_MS=10000
# Hard cap on Kiln calls per session (D2). Warn above 80%, block before 100%.
LLM_CALL_CAP=60

# --- simulation --------------------------------------------------------------------
# 1 real second = CLOCK_MULT simulated seconds (60 for the demo, 600 for local e2e).
CLOCK_MULT=60
# Top-up trigger: remaining < TOPUP_TRIGGER x current hold.
TOPUP_TRIGGER=0.4
# Executor halts at chain deadline - DEADLINE_MARGIN_S.
DEADLINE_MARGIN_S=15
# live | snapshot
PRICE_SOURCE=live
SCENARIO=normal

# --- server ----------------------------------------------------------------------
# Always bound to 127.0.0.1.
PORT=8787
